{
  "name": "@arcana/db-migrations",
  "version": "0.1.0",
  "private": true,
  "description": "Centralized database migrations for ARCANA (golang-migrate)",
  "scripts": {
    "migrate:up": "migrate -path ./migrations -database \"$DATABASE_URL\" up",
    "migrate:down": "migrate -path ./migrations -database \"$DATABASE_URL\" down 1",
    "migrate:create": "migrate create -ext sql -dir ./migrations -seq",
    "migrate:version": "migrate -path ./migrations -database \"$DATABASE_URL\" version"
  }
}
