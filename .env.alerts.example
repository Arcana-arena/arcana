# ARCANA alerting. Copy to .env.alerts beside it, fill in, chmod 600.
#
# NEVER commit the filled-in file, and never inline these values in a systemd
# unit. See docs/alerting.md.

# The ntfy topic alerts are published to.
#
# ON ntfy.sh THE TOPIC IS THE CREDENTIAL. There is no other authentication:
# anyone who knows the topic can read every alert this system sends AND publish
# convincing fake ones. Use a long random name, not a guessable one.
# Subscribe at https://ntfy.sh/<topic> in a browser or in the ntfy mobile app.
NTFY_TOPIC=

# The ntfy server to publish to.
NTFY_SERVER=

# Dead-man switch: a URL pinged on a schedule, so that SILENCE becomes an alarm
# somewhere else rather than looking like calm.
#
# Deliberately empty until an account for it exists — see docs/alerting.md,
# "What is deliberately NOT monitored". While it is empty, total loss of this
# host is silent, because nothing running on a dead machine can report that it
# died.
HEALTHCHECK_PING_URL=
