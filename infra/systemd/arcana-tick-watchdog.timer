# arcana-tick-watchdog.timer — one silent-failure check a day.
#
# CADENCE: 04:00 UTC. Placed after the scheduler's LAST idempotent retry and
# before the backup, so it judges a settled day:
#   23:00 UTC  tick opens          (arcana-scheduler)
#   01:00 UTC  scheduler retry
#   03:00 UTC  scheduler retry     <- last chance for a tick to appear
#   04:00 UTC  THIS CHECK
#   04:30 UTC  backup
#
# Running it earlier would report a missing tick that a later retry was about to
# create — a false alarm, and false alarms are more damaging than no alarm here:
# somebody woken by a check that is usually wrong will disable it permanently.
#
# Persistent=true: a missed run fires at the next boot. A late check still
# reports a real gap, and a gap in the record is the thing worth knowing about
# whenever it is found.
[Unit]
Description=Run the ARCANA tick watchdog daily

[Timer]
OnCalendar=*-*-* 04:00:00 UTC
RandomizedDelaySec=120
Persistent=true

[Install]
WantedBy=timers.target
