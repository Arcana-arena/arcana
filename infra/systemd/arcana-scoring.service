# scoring-engine (Go) — ARCANA Score batch + score/leaderboard API
[Unit]
Description=ARCANA Scoring Engine
After=network-online.target docker.service arcana-decision.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/arcana/services/scoring-engine
Environment=DATABASE_URL=postgres://arcana:arcana@localhost:5432/arcana?sslmode=disable
Environment=PORT=8082
# Secrets (AUTH_JWT_SIGNING_KEY, INTERNAL_API_KEY) come from this file at
# mode 600. They are NEVER inline here: unit files are world-readable and
# systemctl show prints Environment= to any user.
EnvironmentFile=-/home/ubuntu/arcana/.env.auth
# RUNS A BUILT BINARY, NOT `go run`.
#
# `go run` compiles and then execs the program as a CHILD, so systemd was
# supervising the compiler rather than the service: an extra ~7 MB process per
# service, a recompile on every restart, and signals and exit codes arriving
# one hop away from where they were sent.
#
# The trade-off it hid: restarting used to be the same as deploying. It is not
# any more, so the binary carries the commit it was built from and reports it
# on /healthz — see infra/verify/deployed-version-verify.sh.
ExecStart=/home/ubuntu/arcana/scheduler-bin/scoring-engine
Restart=on-failure
RestartSec=5

# A 2 GB HOST, AND A BATCH THAT WALKS THE WHOLE RECORD. On 2026-10-22 a batch
# with no ceiling pushed this box into swap and it stopped answering on port 22
# and 443 for about a hundred minutes. There was no OOM line: it thrashed, it
# did not die. These bounds make that failure mode LOCAL and loud — the cgroup
# kills the batch, systemd restarts the service, and the rest of the platform
# keeps running. The swap ceiling matters as much as the memory one: a cgroup
# allowed to swap does not fail fast, it thrashes.
MemoryMax=700M
MemorySwapMax=128M
# Background work must not outrank the API, the pacer or the executor for CPU.
# DISK IS DELIBERATELY *NOT* THROTTLED: the first version set
# IOSchedulingClass=idle and a daily batch that measures 181s took over nine
# minutes behind the pacer's writes — slow enough to hit its own client timeout,
# which is a failure this service manufactures for itself. The memory cgroup and
# the statement timeout are the guards against a host-wide outage; they do not
# need the disk starved as well.
Nice=10
CPUWeight=20

[Install]
WantedBy=multi-user.target
