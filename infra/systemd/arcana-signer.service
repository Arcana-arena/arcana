# arcana-signer.service — the only process that holds key material.
#
# WHY THIS UNIT LOOKS DIFFERENT FROM THE OTHER SIX. Every other ARCANA service
# runs as `ubuntu` and can read `ubuntu`'s files. This one will eventually hold
# the keys to hundreds of wallets containing other people's money, so it runs as
# its own Linux user and its seed is readable by that user alone. If it ran as
# `ubuntu`, a bug in any of the six public-facing services would be a bug that
# can read the keys, and the separation would be a diagram rather than a fact.
#
# THE SEED IS NOT IN AN ENVIRONMENT FILE. Other services take secrets through
# EnvironmentFile=; this one takes a PATH and reads the file itself. Environment
# is visible in /proc/<pid>/environ to anything running as the same user, is
# inherited by every child process, and is printed by a careless crash handler.
# A file is read once, by a process that refuses to start if its mode is wrong.
#
# IT DOES NOT BROADCAST. The service signs and returns; nothing in it can send a
# transaction. That is what makes it safe to run before the custody decision is
# made.
[Unit]
Description=ARCANA Signer (isolated key custody)
After=network-online.target
Wants=network-online.target
OnFailure=arcana-alert@%n.service

[Service]
Type=simple
User=arcana-signer
Group=arcana-signer
WorkingDirectory=/etc/arcana/signer
Environment=PORT=8085
Environment=SIGNER_MASTER_SEED_FILE=/etc/arcana/signer/master.key
Environment=SIGNER_ALLOWLIST_FILE=/etc/arcana/signer/allowlist.json
# Owner-imported keys (phase 12). Unset disables import entirely, which is the
# right default: an unset variable must not be able to enable key storage by
# accident. The directory is 0700 and owned by arcana-signer, and the service
# REFUSES TO START if it is readable by anyone else — the same rule the master
# seed has, for the same reason.
Environment=SIGNER_IMPORT_DIR=/etc/arcana/signer/imported
# NOTHING THIS UNIT TOUCHES LIVES UNDER /home/ubuntu.
#
# The first version pointed at the repo, and systemd refused to start it:
# arcana-signer cannot traverse into the application users home. That was the
# isolation working, so the fix was to remove the dependency rather than to
# widen the permission. Binary, allowlist and env are installed to system paths.
#
# The shared internal API key is copied into a file owned root:arcana-signer at
# mode 0640 — readable by this service, writable by neither. The same secret
# exists twice, each copy at the permissions its reader needs; the alternative
# was granting a key-holding process read access into the home directory of the
# user that serves HTTP, which is worse.
EnvironmentFile=-/etc/arcana/signer/signer.env
ExecStart=/usr/local/bin/arcana-signer
Restart=on-failure
RestartSec=5

# Defence in depth. None of these is the reason the service is safe — the
# allowlist and the seed's file mode are — but each removes something this
# process has no business being able to do.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/etc/arcana/signer
# The ONE writable path this service gets, and it is a subdirectory rather than
# the whole config directory.
#
# ProtectSystem=strict plus ReadOnlyPaths made /etc/arcana/signer read-only,
# which is exactly right for the master seed and the allowlist: neither should
# ever be written by the process that reads them. Owner-imported keys (phase
# 12) are the one thing this service legitimately creates at runtime, and the
# first import attempt failed with "read-only file system" — the hardening
# working, caught by the verification suite rather than in production.
#
# Narrowed to the subdirectory so the seed and the allowlist stay unwritable.
# A compromised signer still cannot rewrite the allowlist to admit a router of
# its choosing, which is the property that matters most here.
ReadWritePaths=/etc/arcana/signer/imported
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# The seed must never reach a core dump.
LimitCORE=0

[Install]
WantedBy=multi-user.target
