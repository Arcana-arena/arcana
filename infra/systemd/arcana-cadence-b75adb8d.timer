# arcana-cadence-b75adb8d.timer — look every minute, act on the interval.
#
# The same schedule as arcana-cadence.timer, for the same reasons (written
# there): the timer must look at least as often as the shortest interval the
# binary accepts, and a run that is not due exits after three cheap reads.
[Unit]
Description=Run the ARCANA continuous cadence check for competition b75adb8d every minute

[Timer]
OnCalendar=*-*-* *:*:00 UTC
RandomizedDelaySec=5
Persistent=true

[Install]
WantedBy=timers.target
