# decision-engine (Go) — records agent decisions, portfolios, executes ticks
[Unit]
Description=ARCANA Decision Engine
After=network-online.target docker.service arcana-marketdata.service arcana-agent.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/arcana/services/decision-engine
Environment=DATABASE_URL=postgres://arcana:arcana@localhost:5432/arcana?sslmode=disable
Environment=PORT=8081
Environment=MARKET_DATA_URL=http://localhost:8083
# Secrets (AUTH_JWT_SIGNING_KEY, INTERNAL_API_KEY) come from this file at
# mode 600. They are NEVER inline here: unit files are world-readable and
# systemctl show prints Environment= to any user.
EnvironmentFile=-/home/ubuntu/arcana/.env.auth
# LLM_API_KEY, and any provider override, come from their own file at mode 600.
# Separate from .env.auth on purpose: a provider key is rotated on a different
# schedule and by a different person than the signing keys, and a file that
# mixes them invites copying the wrong line.
#
# Without it the service still boots and serves /healthz, and every agent with
# strategy_type='llm' records a HOLD with reason llm_unavailable. There is no
# fallback to a deterministic strategy by design.
EnvironmentFile=-/home/ubuntu/arcana/.env.llm
# RUNS A BUILT BINARY, NOT `go run`.
#
# `go run` compiles and then execs the program as a CHILD, so systemd was
# supervising the compiler rather than the service: an extra ~7 MB process per
# service, a recompile on every restart, and signals and exit codes arriving
# one hop away from where they were sent.
#
# The trade-off it hid: restarting used to be the same as deploying. It is not
# any more, so the binary carries the commit it was built from and reports it
# on /healthz — see infra/verify/deployed-version-verify.sh.
ExecStart=/home/ubuntu/arcana/scheduler-bin/decision-engine
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
