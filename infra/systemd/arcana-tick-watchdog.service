# arcana-tick-watchdog.service — detects the failure OnFailure= cannot see.
#
# A scheduler that runs, exits 0 and produces no tick is not a failed unit, so
# systemd has nothing to report. The symptom that matters is "no tick on a day
# the market was open", and that is what this measures. See the script header
# and docs/alerting.md.
#
# It is READ-ONLY by construction: it asks market-data which session date to
# look at (GET /v1/market/session/expected, the same session.LastCompleted the
# daily fetch uses) and reads the database. It never calls the daily fetch
# endpoint, which would create a snapshot — a monitor must not mutate what it
# observes.
#
# Failing here (exit 1) means the CHECK could not be performed, which is itself
# worth knowing, so this unit carries OnFailure= like the ones it watches.
[Unit]
Description=ARCANA tick watchdog (silent-failure detection)
After=network-online.target arcana-marketdata.service docker.service
Wants=network-online.target
OnFailure=arcana-alert@%n.service

[Service]
Type=oneshot
User=ubuntu
SyslogIdentifier=arcana-tick-watchdog
WorkingDirectory=/home/ubuntu/arcana
Environment=MARKET_DATA_URL=http://127.0.0.1:8083
Environment=SCHEDULER_UNIT=arcana-scheduler.service
EnvironmentFile=-/home/ubuntu/arcana/.env.alerts
ExecStart=/usr/bin/flock -n /tmp/arcana-tick-watchdog.lock /home/ubuntu/arcana/infra/alerting/arcana-tick-watchdog.sh
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
