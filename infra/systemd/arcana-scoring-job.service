# arcana-scoring-job.service — runs the ARCANA Score batch once.
# Invoked by arcana-scoring-job.timer every 5 minutes.
# Uses the scoring engine HTTP batch endpoint (service arcana-scoring.service).
#
# Overlap protection, two independent layers:
#   1. systemd: it will not run a second instance of this unit while the first
#      is still activating. This is what has actually held so far.
#   2. flock wrapping the command, so the lock is held for the whole run and
#      also covers invocations that never go through systemd — a manual run or
#      another script hitting the batch endpoint through this unit.
#
# The lock previously sat in ExecStartPre as `flock -n LOCK true`, which took
# the lock, ran `true` and released it before ExecStart began — it guarded
# nothing. Layer 1 was doing all the work.
[Unit]
Description=ARCANA Score batch job
After=arcana-scoring.service
Wants=arcana-scoring.service

OnFailure=arcana-alert@%n.service

[Service]
Type=oneshot
User=ubuntu
# Without this every journal line would be attributed to `flock` (previously
# `curl`), since flock is now the process systemd executes.
SyslogIdentifier=arcana-scoring-job
Environment=SCORING_URL=http://localhost:8082
# Secrets (AUTH_JWT_SIGNING_KEY, INTERNAL_API_KEY) come from this file at
# mode 600. They are NEVER inline here: unit files are world-readable and
# systemctl show prints Environment= to any user.
EnvironmentFile=-/home/ubuntu/arcana/.env.auth
ExecStart=/usr/bin/flock -n /tmp/arcana-scoring.lock /home/ubuntu/arcana/infra/systemd/arca-job.sh scoring-batch ${SCORING_URL}/internal/v1/scoring/batch
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
