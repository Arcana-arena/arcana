# web (Next.js) — the public surface. Reads only; signs nothing.
[Unit]
Description=ARCANA Web
After=network-online.target arcana-agent.service arcana-marketplace.service arcana-arca.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/arcana/services/web
Environment=PORT=3000
# THE WEB APP READS THE SERVICES DIRECTLY, NOT THROUGH NGINX. Its server-side
# reads would otherwise all arrive from 127.0.0.1 and the site would throttle
# itself out of the proxy's per-IP limiter — loopback is deliberately not
# exempt from it. These are server-to-server reads and never reach a browser.
Environment=AGENT_API=http://127.0.0.1:3001
Environment=MARKETPLACE_API=http://127.0.0.1:3002
# arca-service runs on 3004 on this host (3003 is taken), same override the
# marketplace unit carries. The code default is 3003.
Environment=ARCA_API=http://127.0.0.1:3004
Environment=NEXT_PUBLIC_ARCANA_CHAIN_ID=4663

# WHICH ORIGIN SIGN-IN IS FOR — the same file the agent service reads, under
# the same names, so the page always compares its own host against what the
# server will actually accept. Read at request time, not baked into the build,
# so changing the domain is a restart and not a rebuild.
#
# The web app was briefly going to read SIWE_DOMAIN/SIWE_URI and have this unit
# copy the values across — which would have been a second name for one fact,
# and systemd does
# not expand ${VAR} in Environment= anyway, so the copy would have been the
# literal string. It reads AUTH_SIWE_DOMAIN/AUTH_SIWE_URI directly instead.
EnvironmentFile=-/home/ubuntu/arcana/.env.siwe

# Set to the https origin once TLS is on, so session cookies are marked Secure.
# Left unset on loopback http, where a Secure cookie would simply never be sent.
# Environment=PUBLIC_ORIGIN=https://arcana.example
# No secrets. This process has no session, no key and no write path: the only
# thing it stores is the visitor’s own session cookie, which it never reads back
# into a page.
ExecStart=/usr/bin/npx next start -p 3000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
