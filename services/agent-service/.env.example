# Environment variables for ARCANA services.

# Copy this file to `.env` and adjust values.
# NEVER commit `.env`. The `.commandcode` folder is local-only and never deployed.

# --- Node services ---
PORT=3001

# --- Go services ---
DECISION_ENGINE_PORT=8081
SCORING_ENGINE_PORT=8082
MARKET_DATA_PORT=8083

# --- PostgreSQL ---
DATABASE_URL=postgres://arcana:arcana@localhost:5432/arcana

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Kafka ---
KAFKA_BROKERS=localhost:9092
# URL of arca-service for $ARCA entitlement checks (CREATE / COMPETE / EVOLVE).
ARCA_SERVICE_URL=http://localhost:3004
