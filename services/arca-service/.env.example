# --- arca-service ---
PORT=3003
DATABASE_URL=postgres://arcana:arcana@localhost:5432/arcana?sslmode=disable

# --- TWO TOKENS, AND THEY ARE NOT THE SAME THING ---
#
# They were one variable while both were $ARCA. Splitting them on 2026-09-11
# is what let the marketplace go live without waiting for a token launch.

# PAYMENT: what a buyer sends a creator for a listing.
#
# USDG, which exists on chain today. The phase-11 verification was already
# driven against REAL USDG TRANSFERS other people made, so the payment path is
# proven against exactly this token rather than a stand-in for it.
#
# Its DECIMALS are read from the chain via decimals() and are deliberately not
# configurable — a wrong guess scales every price check by a factor of a
# trillion without erroring. symbol() is never consulted: on a permissionless
# chain it is attacker-written text, and matching is on the address.
MARKETPLACE_PAYMENT_TOKEN=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168

# GATING: what a creator must HOLD to create, compete, evolve, or enter a
# premium arena. $ARCA, NOT LAUNCHED YET — leave empty.
#
# While empty, gating admits everyone and says so in every response. It no
# longer blocks the marketplace; that was the whole point of the split.
ARCA_TOKEN_ADDRESS=
# RPC endpoint for Robinhood Chain (mainnet or testnet) / local simulator.
ARCA_RPC_URL=
# Chain id for signing (default 31337 = anvil dev; Robinhood Chain is 4663).
ARCA_CHAIN_ID=31337

# NOTE ON DECIMALS. There is no ARCA_TOKEN_DECIMALS any more, for either
# token. It used to default to 18 "because that is the ERC-20 convention", and
# USDG uses 6. Each reader asks its own token's decimals() at the moment it is
# needed. There is deliberately no fallback: a token that cannot be asked is a
# token that cannot be verified against, which is a 503, not a guess.

# --- Marketplace payment claims (P2P, tx-hash confirmation) ---
# Confirmations before a claimed payment is accepted. Default 600.
#
# THIS IS A BLOCK COUNT ON A 0.100 s/BLOCK CHAIN. 600 blocks is about SIXTY
# SECONDS. It is chosen in wall-clock terms and the block count derived from
# it, not the other way round — the previous value, 12, was Ethereum's
# convention (~2.5 minutes there) and meant 1.2 seconds here.
ARCA_CLAIM_MIN_CONFIRMATIONS=600
# How recent a transaction must be to be claimable (hours). Default 24.
# Without a limit, ANY historical transfer from a buyer to a creator becomes a
# claim: a tip, an unrelated trade, last year's subscription.
ARCA_CLAIM_MAX_AGE_HOURS=24

# --- Subscription ---
# Period granted per confirmed payment (days). Default 30 (§7 has no per-listing
# duration column).
SUBSCRIPTION_DAYS=30

# --- $ARCA entitlement gating (§2.7) ---
# Minimum $ARCA balance required per gated action. UNSET = that action passes
# without any balance check, and the response says so explicitly.
#
# All are unset here on purpose: the thresholds have not been decided and the
# token has not launched. Setting one before ARCA_TOKEN_ADDRESS exists changes
# nothing — gating stays inactive while the chain is unreadable.
ARCA_GATE_CREATE=
ARCA_GATE_COMPETE=
ARCA_GATE_EVOLVE=
ARCA_GATE_ACCESS=
ARCA_GATE_MARKETPLACE=
ARCA_GATE_PASSPORT=
ARCA_GATE_PREMIUM_ARENA=
# ^ Gates entry into a Premium Arena -- a season with access_tier='premium'
# (migration 0020). Checked at registration IN ADDITION TO ARCA_GATE_COMPETE,
# not instead of it, so the effective requirement is the larger of the two and
# a low premium threshold can never become a cheap way past COMPETE.
# See docs/premium-arena.md.

# --- RETIRED 2026-09-11 (§10 deposit-address subsystem) ---
# ARCA_MASTER_PRIVATE_KEY, ARCA_TREASURY_PRIVATE_KEY, ARCA_CONFIRMATIONS,
# ARCA_POLL_INTERVAL_MS, ARCA_AUDIT_INTERVAL_MS, ARCA_DEPOSIT_TTL_HOURS,
# ARCA_TOKEN_DECIMALS.
#
# Listed here rather than merely deleted so that an operator restoring an old
# .env sees that these are dead and does not conclude a variable went missing.
# Nothing reads them. The buyer pays the creator directly now; ARCANA holds no
# deposit address, no treasury and no master seed for payments.
