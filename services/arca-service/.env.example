# --- arca-service ---
PORT=3003
DATABASE_URL=postgres://arcana:arcana@localhost:5432/arcana?sslmode=disable

# --- $ARCA master wallet (HD deposit derivation) ---
# SECURITY: NEVER commit a real key. In production load from KMS/secret manager.
# 32-byte private key (hex, with or without 0x) used as the BIP32 master seed
# for deriving per-subscription deposit addresses (path m/44'/60'/0'/0/{n}).
# When unset, deposit generation is disabled (service still serves /healthz).
ARCA_MASTER_PRIVATE_KEY=

# --- $ARCA token + chain (payment listener) ---
# Contract address of the $ARCA ERC-20 token. NOT LAUNCHED YET — leave empty;
# the listener refuses to run until this is set (never guesses an address).
ARCA_TOKEN_ADDRESS=
# RPC endpoint for Robinhood Chain (mainnet or testnet) / local simulator.
ARCA_RPC_URL=
# Chain id for signing (default 31337 = anvil dev; set real Robinhood id in prod).
ARCA_CHAIN_ID=31337
# Confirmation threshold (blocks) before a payment is processed. Default 12;
# conservative until the chain's block time/finality is known. Anvil tests use 1.
ARCA_CONFIRMATIONS=12
# Listener poll interval (ms). Default 15000.
ARCA_POLL_INTERVAL_MS=15000
# How long a deposit address stays valid (hours). Default 24. This is the
# `expires_in` returned by subscribe AND the age at which the audit may retire
# an unfunded address so it stops holding the listener's scan floor. One value
# for both on purpose — retiring earlier than promised would strand a payment
# the user made in good time.
ARCA_DEPOSIT_TTL_HOURS=24
# Deposit audit interval (ms). Default 300000 (5 min). The audit asks the chain
# whether any still-pending deposit address already holds a balance — i.e. a
# user paid and was never granted access — and logs it at ERROR. Backstop only;
# it should never fire.
ARCA_AUDIT_INTERVAL_MS=300000
# $ARCA token decimals. ASSUMED 18 (not stated in architecture.md) — override
# once the real token is known.
ARCA_TOKEN_DECIMALS=18

# --- Treasury / operations wallet for payouts (Tahap 4) ---
# Private key of the operational wallet that sends creator payouts. Must hold
# ETH for gas AND $ARCA to distribute. Separate from the HD deposit master.
ARCA_TREASURY_PRIVATE_KEY=

# --- Subscription ---
# Period granted per confirmed payment (days). Default 30 (§7 has no per-listing
# duration column).
SUBSCRIPTION_DAYS=30

# --- $ARCA entitlement gating (§2.7) ---
# Minimum $ARCA balance required per gated action. UNSET = that action passes
# without any balance check, and the response says so explicitly.
#
# All are unset here on purpose: the thresholds have not been decided and the
# token has not launched. Setting one before ARCA_TOKEN_ADDRESS exists changes
# nothing — gating stays inactive while the chain is unreadable.
ARCA_GATE_CREATE=
ARCA_GATE_COMPETE=
ARCA_GATE_EVOLVE=
ARCA_GATE_ACCESS=
ARCA_GATE_MARKETPLACE=
ARCA_GATE_PASSPORT=
ARCA_GATE_PREMIUM_ARENA=
