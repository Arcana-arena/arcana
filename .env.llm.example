# Provider credentials for the LLM decider. Copy to .env.llm beside it, fill in,
# chmod 600. NEVER commit the filled-in file.
#
# The provider abstraction in services/decision-engine/internal/llm speaks the
# OpenAI chat-completions shape, so changing provider is these five values
# rather than surgery.
#
# VERIFY A PROVIDER BY EXECUTION BEFORE WRITING IT HERE: ask it for its model
# list, then send one chat-completion in exactly the shape the decision engine
# sends and check what comes back. A provider that answers the model list and
# then returns something the engine cannot parse is a provider that fails at the
# first tick rather than at configuration time.

# Provider identifier, recorded on every decision.
LLM_PROVIDER=

# Base URL WITHOUT a trailing /v1 — the client appends /v1/chat/completions
# itself, and a URL that already carries /v1 produces /v1/v1/chat/completions.
LLM_BASE_URL=

# Model id, recorded on every decision so a score can be traced back to the
# thing that produced it.
LLM_MODEL=

LLM_API_KEY=

# Request timeout in milliseconds.
LLM_TIMEOUT_MS=
