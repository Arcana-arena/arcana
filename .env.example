# --- agent-service ---
PORT=3001
# DATABASE_URL=postgres://arcana:arcana@localhost:5432/arcana?sslmode=disable

# --- marketplace-service ---
# PORT=3002

# --- arca-service ---
# PORT=3003

# --- Go services ---
# DECISION_ENGINE_PORT=8081
# SCORING_ENGINE_PORT=8082
# MARKET_DATA_PORT=8083

# --- Database (used by golang-migrate + services) ---
# Local (via infra/docker/docker-compose.yml):
# DATABASE_URL=postgres://arcana:arcana@localhost:5432/arcana?sslmode=disable
# VPS (projecteon) — tunnel or point directly at the VPS host:
# DATABASE_URL=postgres://arcana:arcana@<vps-host>:5432/arcana?sslmode=disable

# --- Object storage (MinIO/S3) — market-data service ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=arcana
S3_SECRET_KEY=arcana-secret
S3_BUCKET=arcana-market

# --- Data stack (infra/docker) ---
POSTGRES_DB=arcana
POSTGRES_USER=arcana
POSTGRES_PASSWORD=arcana
MINIO_ROOT_USER=arcana
MINIO_ROOT_PASSWORD=arcana-secret

# --- LLM decider (decision-engine) ---
# The KEY lives in .env.llm at mode 600 on the host, never here and never in a
# unit file. Everything else is provider configuration with a DeepSeek default:
# switching provider is these three values, not a code change.
# LLM_PROVIDER=deepseek
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
# LLM_API_KEY=            # -> .env.llm, mode 600
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=700
